  "cards": [
    {
      "dot": "cyan",
      "title": "Sanitization & Pre-Egress",
      "items": [
        "Go collector redacts network and machine identifiers before payload leaves host memory",
        "Evidence wrapped in explicit <evidence> delimiters with instruction boundary prompts",
        "Read-only advisory: diagnosis pipeline never initiates kernel writes autonomously"
      ]
    },
    {
      "dot": "emerald",
      "title": "Low Latency & Cache",
      "items": [
        "Fingerprint hash combines redacted evidence, corpus version, and LLM model",
        "Identical host failures serve from memory cache in sub-millisecond latency at zero cost",
        "Hybrid RAG merges BM25 keyword matching with dense semantic embeddings"
      ]
    },
    {
      "dot": "rose",
      "title": "Resilience & Fallback",
      "items": [
        "LLM client employs 3x exponential backoff retries against upstream 429/5xx errors",
        "Graceful degradation returns sanitized host evidence if AI service is unavailable",
        "Safety filter scans recommendations for dangerous commands before client delivery"
      ]
    }
  ]
