  "cards": [
    {
      "dot": "rose",
      "title": "Untrusted Ingestion",
      "items": [
        "Host logs are treated as untrusted data vulnerable to indirect injection",
        "Pre-egress regex redactor strips IP addresses, MACs, usernames, hostnames, and UUIDs",
        "System prompt confines log text within strict <evidence> boundaries"
      ]
    },
    {
      "dot": "emerald",
      "title": "Grounded Retrieval",
      "items": [
        "BM25 handles exact kernel error strings like Unknown symbol or Key not available",
        "ChromaDB handles semantic proximity via 384-dimensional dense vectors",
        "Reciprocal Rank Fusion merges rankings without arbitrary weight tuning"
      ]
    },
    {
      "dot": "cyan",
      "title": "Egress Enforcement",
      "items": [
        "Output safety filter scans recommended commands against a destructive pattern blocklist",
        "Strict Pydantic schema validation rejects unstructured, partial, or malformed LLM responses",
        "Structured audit logger records caller token ID, module name, and execution result"
      ]
    }
  ]
