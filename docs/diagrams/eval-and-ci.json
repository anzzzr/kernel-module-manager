  "cards": [
    {
      "dot": "cyan",
      "title": "Evaluation Dataset",
      "items": [
        "46 realistic test cases covering 8 kernel failure categories plus healthy and noisy samples",
        "Includes gold root causes, gold diagnostic keywords, and authoritative document citations",
        "Fully reproducible locally with no root privileges or live Linux kernel VM required"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ablation Benchmark",
      "items": [
        "Evaluates three execution pipelines: no_rag (zero docs), rag (hybrid top-k), and full_docs",
        "Tracks retrieval quality (Recall@k, MRR) and diagnosis quality (category accuracy, keyword coverage)",
        "Measures cost and latency trade-offs: RAG achieves 92.4% accuracy at 1/15th the token cost of full context"
      ]
    },
    {
      "dot": "rose",
      "title": "Continuous Integration",
      "items": [
        "GitHub Actions runs Go unit tests with race detection and constant-time auth verification",
        "Python suite runs ruff linter and pytest tests for degraded mode, caching, and safety gates",
        "Mocked LLM smoke test executes evaluation pipeline offline on every commit without secrets"
      ]
    }
  ]
