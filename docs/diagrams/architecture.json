  "cards": [
    {
      "dot": "cyan",
      "title": "Defense in Depth",
      "items": [
        "Go daemon runs with ambient CAP_SYS_MODULE without requiring full root",
        "Module allowlist and critical driver denylist guard against accidental storage/filesystem driver unloading",
        "Pre-egress regex sanitization scrubs IPs, MACs, hostnames, and secrets from telemetry"
      ]
    },
    {
      "dot": "emerald",
      "title": "Hybrid Retrieval Engine",
      "items": [
        "Combines lexical BM25 exact error matching with ChromaDB 384-d dense embeddings",
        "Reciprocal Rank Fusion (RRF) prioritizes exact kernel errors like Unknown symbol and Key not available",
        "26 original Markdown docs with source URLs ground all LLM reasoning"
      ]
    },
    {
      "dot": "violet",
      "title": "Operational Observability",
      "items": [
        "X-Request-ID propagation links Go host calls to Python AI inference spans",
        "Per-stage latency tracking (collect, retrieve, LLM, validate) and token cost estimation",
        "SHA-256 fingerprint response cache delivers sub-millisecond responses on duplicate errors"
      ]
    }
  ]
